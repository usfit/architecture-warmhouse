@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100

title User Service — диаграмма компонентов

Container(api, "API Gateway", "Nginx")

Container_Boundary(user, "User Service") {
  Component(user_api, "User API", "Go, Gin", "Принимает REST-запросы")
  Component(profile_manager, "Profile Manager", "Go", "Управление профилем пользователя")
  Component(house_manager, "House Manager", "Go", "Управление домами пользователя")
  Component(membership_manager, "Membership Manager", "Go", "Управление членством пользователя в домах")
  Component(user_repository, "User Repository", "Go", "Доступ к User DB")
}

ContainerDb(user_db, "User DB", "PostgreSQL")

Rel(api, user_api, "REST-запросы", "HTTPS")
Rel(user_api, profile_manager, "Вызывает")
Rel(profile_manager, user_repository, "Читает/пишет данные")

Rel(user_api, house_manager, "Вызывает")
Rel(house_manager, user_repository, "Читает/пишет данные")
Rel(house_manager, membership_manager, "Создатель дома может добавить себя в качестве члена дома")

Rel(user_api, membership_manager, "Вызывает")
Rel(membership_manager, user_repository, "Читает/пишет данные")

Rel(user_repository, user_db, "Читает/пишет данные", "SQL")

@enduml
