@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 100

title Heating Service — диаграмма компонентов

Container(api, "API Gateway", "Nginx")

Container_Boundary(heating, "Heating Service") {
  Component(heating_api, "Heating API", "Go, Gin", "Принимает REST-запросы")
  Component(controller, "Heating Controller", "Go", "Бизнес-логика")
  Component(device_client, "Device Client", "Go", "Связь с Device Manager")
  Component(command_publisher, "Command Publisher", "Go", "Публикует команды в rabbit")
  Component(telemetry_consumer, "Telemetry Consumer", "Go", "Получает показания из rabbit")
  Component(heating_repository, "Heating Repository", "Go", "Доступ к Heating DB")
}

Container(device_manager, "Device Manager Service", "Go")
ContainerQueue(rabbit, "Брокер сообщений", "RabbitMQ")
ContainerDb(heating_db, "Heating DB", "PostgreSQL")

Rel(api, heating_api, "REST-запросы", "HTTPS")
Rel(heating_api, controller, "Вызывает")
Rel(controller, device_client, "Проверка устройств")
Rel(controller, heating_repository, "Читает/пишет данные")
Rel(controller, command_publisher, "Команда вкл/выкл котла")
Rel(device_client, device_manager, "Проверка устройства и его принадлежности дому", "HTTPS")
Rel(command_publisher, rabbit, "Публикует команды", "AMQP")
Rel(telemetry_consumer, heating_repository, "Сохраняет показания")
Rel(telemetry_consumer, controller, "Текущая температура, состояние реле")
Rel(rabbit, telemetry_consumer, "Показания температуры, состояние реле", "AMQP")
Rel(heating_repository, heating_db, "Читает/пишет данные", "SQL")
@enduml
